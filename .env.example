# Finnhub API key (free at finnhub.io)
FINNHUB_API_KEY=your_finnhub_key_here

# LM Studio OpenAI-compatible endpoint
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=lm-studio

# Server
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8765

# Trading
ASTRA_TICK_SECONDS=300
ASTRA_WATCHLIST_SIZE=25
ASTRA_MAX_POSITION_PCT=0.08
ASTRA_DAILY_LOSS_LIMIT_PCT=0.05
ASTRA_FEE_PER_TRADE=1.0
ASTRA_SLIPPAGE_BPS=5

# Auto-exit rules (enforced before the LLM decides)
ASTRA_STOP_LOSS_PCT=0.05
ASTRA_TAKE_PROFIT_PCT=0.15
ASTRA_MIN_CONFIDENCE=0.30

# Optional: priority tickers (evaluated first). Comma-separated.
# Example: ASTRA_CUSTOM_WATCHLIST=NVDA,AMD,TSLA,AAPL,MSFT
ASTRA_CUSTOM_WATCHLIST=

# Paths (relative to project root)
ASTRA_DATA_DIR=./data
